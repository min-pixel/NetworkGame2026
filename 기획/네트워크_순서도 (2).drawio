<mxfile host="app.diagrams.net" type="device"><diagram name="전체 순서도" id="flow-main"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="2910" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="클라이언트" style="swimlane;startSize=22;html=1;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=none;fontStyle=1;fontSize=12.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="4" y="108" width="314" height="2786" as="geometry"/></mxCell><mxCell id="c4" value="네트워크" style="swimlane;startSize=22;html=1;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=none;fontStyle=1;fontSize=12.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318" y="108" width="124" height="2786" as="geometry"/></mxCell><mxCell id="c5" value="서버" style="swimlane;startSize=22;html=1;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=none;fontStyle=1;fontSize=12.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="442" y="108" width="306" height="2786" as="geometry"/></mxCell><mxCell id="c6" value="메인 스레드" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4" y="130" width="192" height="20" as="geometry"/></mxCell><mxCell id="c7" value="수신 스레드" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="196" y="130" width="122" height="20" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="150" as="sourcePoint"/><mxPoint x="196" y="2894" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="전체 순서도: 접속부터 로비 복귀까지" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=15;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="22" y="14" width="261.4" height="21" as="geometry"/></mxCell><mxCell id="c10" value="읽는 법: 왼쪽은 클라이언트, 오른쪽은 서버, 가운데 평행사변형은 오가는 패킷. 위에서 아래로 시간 순서. 상자 색은 그 일을 하는 스레드." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="22" y="36.5" width="723.69" height="17.5" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="24" y="62" width="22" height="14" as="geometry"/></mxCell><mxCell id="c12" value="메인 스레드" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="61" width="68.3" height="17" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="134.3" y="62" width="22" height="14" as="geometry"/></mxCell><mxCell id="c14" value="TCP 수신·통신 스레드" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="160.3" y="61" width="123.63" height="17" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="299.93" y="62" width="22" height="14" as="geometry"/></mxCell><mxCell id="c16" value="UDP 수신 스레드" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="325.93" y="61" width="93.38" height="17" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="435.31" y="62" width="22" height="14" as="geometry"/></mxCell><mxCell id="c18" value="게임 루프 스레드" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="461.31" y="61" width="93.6" height="17" as="geometry"/></mxCell><mxCell id="c19" value="" style="rhombus;html=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="82" width="22" height="14" as="geometry"/></mxCell><mxCell id="c20" value="판단" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="81" width="32" height="17" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=parallelogram;perimeter=parallelogramPerimeter;html=1;fixedSize=1;size=5;fillColor=none;" vertex="1" parent="1"><mxGeometry x="98" y="82" width="26" height="14" as="geometry"/></mxCell><mxCell id="c22" value="패킷" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="128" y="81" width="32" height="17" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=50;html=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="176" y="82" width="26" height="14" as="geometry"/></mxCell><mxCell id="c24" value="이동·끝" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="206" y="81" width="51.25" height="17" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="273.25" y="89" as="sourcePoint"/><mxPoint x="297.25" y="89" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="스레드 시작·큐 전달" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="301.25" y="81" width="112.85" height="17" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430.1" y="89" as="sourcePoint"/><mxPoint x="454.1" y="89" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="실패·끊김" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.1" y="81" width="62.25" height="17" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;서버 준비&lt;/b&gt;&lt;br&gt;TCP 대기 소켓 listen()&lt;br&gt;UDP 소켓 bind()&lt;br&gt;수신·게임 루프 스레드 생성" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="164" width="160" height="72" as="geometry"/></mxCell><mxCell id="c30" value="게임 루프는&lt;br&gt;시작 신호 대기" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="636" y="180" width="94" height="40" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;시작 화면&lt;/b&gt;&lt;br&gt;화면 클릭하면 시작&lt;br&gt;WSAStartup()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="150" height="58" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;서버와 TCP 연결&lt;/b&gt;&lt;br&gt;TCP 소켓 만들기&lt;br&gt;connect()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="150" height="58" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;연결 요청 ↔ 수락&lt;/b&gt;&lt;br&gt;TCP 연결 수립&lt;br&gt;connect / accept" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="238" width="120" height="58" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;연결 받아들이기&lt;/b&gt;&lt;br&gt;accept()로 수락&lt;br&gt;클라마다 TCP 통신 스레드&lt;br&gt;다시 다음 연결 대기" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="252" width="160" height="72" as="geometry"/></mxCell><mxCell id="c35" value="연결됐나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="150" height="44" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;접속 준비&lt;/b&gt;&lt;br&gt;UDP 소켓 만들기&lt;br&gt;수신 스레드 2개 시작" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="150" height="72" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;TCP 통신 스레드 시작&lt;/b&gt;&lt;br&gt;accept 직후 바로&lt;br&gt;참가 가능한지 확인" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="388" width="160" height="58" as="geometry"/></mxCell><mxCell id="c38" value="빈 자리 있고&lt;br&gt;로비 중인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="462" width="160" height="56" as="geometry"/></mxCell><mxCell id="c39" value="자리 없음 또는&lt;br&gt;게임 중 → 거절" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="636" y="468" width="94" height="44" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;자리 등록&lt;/b&gt;&lt;br&gt;PlayerId 배정&lt;br&gt;자리 표에 기록&lt;br&gt;(자리 표 임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="534" width="160" height="72" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;결과·로비 상태 전송&lt;/b&gt;&lt;br&gt;이 클라에게: 접속 결과&lt;br&gt;승인 시 전원에 로비 상태&lt;br&gt;(송신 임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="622" width="160" height="72" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;접속 결과·로비 상태&lt;/b&gt;&lt;br&gt;SC_ConnectResult&lt;br&gt;SC_LobbyState&lt;br&gt;TCP" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="622" width="120" height="72" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;TCP 받기&lt;/b&gt;&lt;br&gt;결과·로비 상태&lt;br&gt;→ 큐(임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="202" y="622" width="106" height="72" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;응답 기다리기&lt;/b&gt;&lt;br&gt;매 프레임 이벤트 큐 확인&lt;br&gt;없으면 다음 프레임에&lt;br&gt;다시 확인" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="150" height="72" as="geometry"/></mxCell><mxCell id="c45" value="승인했나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="710" width="160" height="44" as="geometry"/></mxCell><mxCell id="c46" value="소켓 닫고&lt;br&gt;스레드 종료" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="636" y="710" width="94" height="44" as="geometry"/></mxCell><mxCell id="c47" value="접속 결과가&lt;br&gt;왔나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="150" height="56" as="geometry"/></mxCell><mxCell id="c48" value="승인인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="150" height="44" as="geometry"/></mxCell><mxCell id="c49" value="거절 표시 후&lt;br&gt;시작 화면으로" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="202" y="784" width="106" height="40" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;로비 화면&lt;/b&gt;&lt;br&gt;인원·준비 여부 표시&lt;br&gt;(큐의 로비 상태로)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="150" height="58" as="geometry"/></mxCell><mxCell id="c51" value="대기 버튼을&lt;br&gt;처음 눌렀나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="938" width="150" height="56" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;준비 알리기 (한 번만)&lt;/b&gt;&lt;br&gt;준비 패킷 보내기&lt;br&gt;대기 버튼 끄기&lt;br&gt;→ 다음 프레임부터 건너뜀" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="150" height="72" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;준비 완료&lt;/b&gt;&lt;br&gt;CS_Ready&lt;br&gt;TCP" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="1017" width="120" height="58" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;다음 패킷 기다리기&lt;/b&gt;&lt;br&gt;통신 스레드 recv()&lt;br&gt;패킷이 올 때까지&lt;br&gt;여기서 멈춰 있음" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="1010" width="160" height="72" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;준비 기록&lt;/b&gt;&lt;br&gt;받은 패킷: 준비 완료&lt;br&gt;이 클라를 준비로 표시&lt;br&gt;(자리 표 임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="1170" width="160" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;로비 상태 알리기&lt;/b&gt;&lt;br&gt;전원에게 (송신 임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="1258" width="160" height="44" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;로비 상태&lt;/b&gt;&lt;br&gt;SC_LobbyState&lt;br&gt;TCP · 전원에게" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="1251" width="120" height="58" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;TCP 받기&lt;/b&gt;&lt;br&gt;로비 상태&lt;br&gt;→ 큐(임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="202" y="1251" width="106" height="58" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;큐 확인&lt;/b&gt;&lt;br&gt;매 프레임&lt;br&gt;로비 상태 → 화면 갱신" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeo