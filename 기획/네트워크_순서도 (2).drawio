mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430.1" y="89" as="sourcePoint"/><mxPoint x="454.1" y="89" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="실패·끊김" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=11;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.1" y="81" width="62.25" height="17" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;창 닫기&lt;/b&gt;&lt;br&gt;언제든, 어느 화면에서나&lt;br&gt;closesocket()&lt;br&gt;WSACleanup()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="150" height="72" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;연결 끊김&lt;/b&gt;&lt;br&gt;TCP 연결 종료&lt;br&gt;서버 recv가 0 반환" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="203" width="120" height="58" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;끊김 감지&lt;/b&gt;&lt;br&gt;통신 스레드의 recv()가&lt;br&gt;0 또는 오류 반환&lt;br&gt;(다음 패킷 기다리기)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="196" width="160" height="72" as="geometry"/></mxCell><mxCell id="c32" value="게임 중인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="284" width="160" height="44" as="geometry"/></mxCell><mxCell id="c33" value="끊김 표시&lt;br&gt;다음 틱에 유령&lt;br&gt;자리는 로비&lt;br&gt;복귀 때 정리" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="636" y="270" width="94" height="72" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;자리 비우기&lt;/b&gt;&lt;br&gt;시작 조건 다시 확인&lt;br&gt;남은 전원에 로비 상태&lt;br&gt;(송신 임계 영역)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="348" width="160" height="72" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;소켓 닫기&lt;/b&gt;&lt;br&gt;통신 스레드 종료" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="436" width="160" height="44" as="geometry"/></mxCell><mxCell id="c36" value="이 클라이언트 연결 끝" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="496" width="160" height="28" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;서버 종료&lt;/b&gt;&lt;br&gt;오류·강제 종료 포함" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="593" width="160" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;연결 끊김&lt;/b&gt;&lt;br&gt;TCP 연결 종료&lt;br&gt;클라 recv가 0/오류" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="320" y="586" width="120" height="58" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;TCP 받기&lt;/b&gt;&lt;br&gt;recv()가&lt;br&gt;0 또는 오류" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="202" y="586" width="106" height="58" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;끊김 처리&lt;/b&gt;&lt;br&gt;소켓·스레드 정리&lt;br&gt;끊김 메시지 표시" style="rounded=1;arcS